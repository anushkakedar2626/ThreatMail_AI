{
  "timeZone": "Asia/Kolkata",
  "dependencies": {},
  "exceptionLogging": "CLOUD",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.message.readonly"
  ],
  "addOns": {
    "common": {
      "name": "ThreatMail AI",
      "logoUrl": "https://www.gstatic.com/images/branding/product/1x/gmail_2020q4_48dp.png",
      "layoutProperties": {
        "primaryColor": "#172554",
        "secondaryColor": "#2563EB"
      }
    },
    "gmail": {
      "homepageTrigger": {
        "enabled": true,
        "runFunction": "onHomepage"
      },
      "contextualTriggers": [
        {
          "unconditional": {},
          "onTriggerFunction": "onGmailMessage"
        }
      ]
    }
  }
}