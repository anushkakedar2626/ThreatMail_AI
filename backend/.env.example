# Copy this file to .env and fill in your free-tier API keys.
# Leave any of these blank and the system automatically falls back to mock/demo data.
IPINFO_TOKEN=
ABUSEIPDB_KEY=
VIRUSTOTAL_KEY=

# Optional Gemini explainability layer. Keep this key server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail automatic monitoring
GMAIL_MONITOR_ENABLED=true
GMAIL_POLL_SECONDS=15
